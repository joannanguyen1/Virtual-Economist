# Leave both empty so the smart fallbacks in src/lib/api.ts pick the right base URL:
#   - Local dev (npm start):  auth -> http://localhost:800, agent -> http://localhost:8000
#   - Deployed (built bundle): auth -> ${origin}/auth, agent -> same origin (relative)
# Override here only if you need to point at a remote backend during local dev.
REACT_APP_API_URL=
REACT_APP_AGENT_API_URL=
